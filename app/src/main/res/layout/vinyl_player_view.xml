<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vinylPlayerContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- Main Vinyl Player Layout: Left side info, Right side vinyl -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- LEFT SIDE: Album Info and Playlist Preview -->
        <LinearLayout
            android:id="@+id/leftInfoPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/rightVinylPanel"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/attributionFooter"
            app:layout_constraintWidth_percent="0.45">

            <!-- Album Cover -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="8dp">

                <ImageView
                    android:id="@+id/vinylLeftAlbumArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/default_album_art"
                    android:contentDescription="@string/unknown_album" />
            </androidx.cardview.widget.CardView>

            <!-- Song Info -->
            <TextView
                android:id="@+id/vinylSongTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_songs"
                android:fontFamily="@font/vt323"
                android:textSize="20sp"
                android:textAlignment="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/vinylArtistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/unknown_artist"
                android:fontFamily="@font/vt323"
                android:textSize="16sp"
                android:textAlignment="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="4dp" />

            <!-- Progress Bar -->
            <SeekBar
                android:id="@+id/vinylSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:layout_marginVertical="8dp" />

            <!-- Time Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/vinylCurrentTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:fontFamily="@font/vt323"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/vinylTotalTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:fontFamily="@font/vt323"
                    android:textSize="14sp"
                    android:textAlignment="textEnd" />
            </LinearLayout>

            <!-- Playlist Preview -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Up Next"
                android:fontFamily="@font/vt323"
                android:textSize="16sp"
                android:textAlignment="center"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vinylPlaylistPreview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- RIGHT SIDE: Vinyl Player -->
        <FrameLayout
            android:id="@+id/rightVinylPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@id/leftInfoPanel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/attributionFooter"
            app:layout_constraintWidth_percent="0.55">

            <!-- Vinyl Disc Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/vinylDiscCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                app:cardCornerRadius="1000dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#1a1a1a">

                <com.pixeltunes.app.VinylPlayerView
                    android:id="@+id/vinylDisc"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/vinyl_disc_background">

                    <!-- Center Album Art -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        app:cardCornerRadius="60dp"
                        app:cardElevation="4dp">

                        <ImageView
                            android:id="@+id/vinylAlbumArt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/default_album_art"
                            android:contentDescription="@string/unknown_album" />
                    </androidx.cardview.widget.CardView>
                </com.pixeltunes.app.VinylPlayerView>
            </androidx.cardview.widget.CardView>

            <!-- Needle Arm (draggable) -->
            <com.pixeltunes.app.DraggableNeedleView
                android:id="@+id/needleArm"
                android:layout_width="100dp"
                android:layout_height="150dp"
                android:src="@drawable/needle_arm"
                android:scaleType="fitStart"
                android:rotation="0"
                android:layout_gravity="top|end"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="40dp"
                android:contentDescription="@string/needle_arm" />

            <!-- Control Buttons below vinyl -->
            <LinearLayout
                android:id="@+id/vinylControlButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/vinylBtnPrevious"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_previous"
                    android:contentDescription="@string/previous"
                    android:layout_marginEnd="24dp" />

                <ImageButton
                    android:id="@+id/vinylBtnNext"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_next"
                    android:contentDescription="@string/next"
                    android:layout_marginStart="24dp" />
            </LinearLayout>

        </FrameLayout>

        <!-- Attribution Footer -->
        <LinearLayout
            android:id="@+id/attributionFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Made by Navaneeth Sankar K P"
                android:fontFamily="@font/vt323"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnLinkedIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LinkedIn"
                    android:fontFamily="@font/vt323"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:layout_marginEnd="8dp"
                    style="?attr/materialButtonOutlinedStyle" />

                <Button
                    android:id="@+id/btnGitHub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@navuxneeth/PixelTunes"
                    android:fontFamily="@font/vt323"
                    android:textSize="12sp"
                    android:padding="8dp"
                    style="?attr/materialButtonOutlinedStyle" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
