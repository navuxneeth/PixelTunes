<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light Theme -->
    <style name="Theme.PixelTunes" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/light_primary</item>
        <item name="colorPrimaryVariant">@color/light_surface</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/pixel_accent</item>
        <item name="colorSecondaryVariant">@color/pixel_green</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/light_background</item>
        <item name="android:navigationBarColor">@color/light_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/light_background</item>
        <item name="android:textColorPrimary">@color/light_text</item>
        <item name="android:textColorSecondary">@color/light_text_secondary</item>
    </style>

    <!-- Dark Theme -->
    <style name="Theme.PixelTunes.Dark" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorPrimaryVariant">@color/dark_surface</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/pixel_accent</item>
        <item name="colorSecondaryVariant">@color/pixel_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
    </style>
</resources>
