    <item android:top="80dp" android:bottom="80dp" android:left="80dp" android:right="80dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#333333" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
